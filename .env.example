# MPLAD-TRACE 360 Environment Configuration
APP_NAME="MPLAD-TRACE 360"
VERSION="1.0.0"
DEMO_MODE=true

# Database (SQLite for local prototype, PostgreSQL for production deployment)
DATABASE_URL=sqlite:///./mplad_trace.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/mplad_trace

# Security
